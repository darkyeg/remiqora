--- /dev/null
+++ b/include/engine/models/yue2/remiqora_progress.h
@@ -0,0 +1,77 @@
+#pragma once
+
+#include <chrono>
+#include <cstdint>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+
+namespace engine::models::yue2 {
+
+// A small, optional side channel for the desktop UI. It never affects sampling
+// or audio output, and is disabled when the desktop has not supplied a path.
+struct RemiqoraProgress {
+    std::mutex mutex;
+    uint64_t seed = 0;
+    int64_t started_ms = 0;
+    int64_t phase_started_ms = 0;
+    std::string phase = "idle";
+    int64_t current = 0;
+    int64_t total = 0;
+};
+
+inline RemiqoraProgress remiqora_progress;
+
+inline int64_t remiqora_now_ms() {
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::system_clock::now().time_since_epoch()).count();
+}
+
+inline void remiqora_write_progress_locked() noexcept {
+    try {
+        const char * path = std::getenv("REMIQORA_YUE2_PROGRESS_PATH");
+        if (path == nullptr || *path == '\0') return;
+        std::ofstream file(std::filesystem::u8path(path), std::ios::trunc);
+        if (!file) return;
+        file << "{\"seed\":" << remiqora_progress.seed
+             << ",\"started_ms\":" << remiqora_progress.started_ms
+             << ",\"phase_started_ms\":" << remiqora_progress.phase_started_ms
+             << ",\"updated_ms\":" << remiqora_now_ms()
+             << ",\"phase\":\"" << remiqora_progress.phase
+             << "\",\"current\":" << remiqora_progress.current
+             << ",\"total\":" << remiqora_progress.total << "}";
+    } catch (...) {
+        // Telemetry must never fail an otherwise valid generation.
+    }
+}
+
+inline void remiqora_begin_progress(uint64_t seed) noexcept {
+    std::lock_guard<std::mutex> guard(remiqora_progress.mutex);
+    remiqora_progress.seed = seed;
+    remiqora_progress.started_ms = remiqora_now_ms();
+    remiqora_progress.phase_started_ms = remiqora_progress.started_ms;
+    remiqora_progress.phase = "preparing";
+    remiqora_progress.current = 0;
+    remiqora_progress.total = 0;
+    remiqora_write_progress_locked();
+}
+
+inline void remiqora_set_progress(const char * phase, int64_t current, int64_t total) noexcept {
+    std::lock_guard<std::mutex> guard(remiqora_progress.mutex);
+    remiqora_progress.phase = phase;
+    remiqora_progress.phase_started_ms = remiqora_now_ms();
+    remiqora_progress.current = current;
+    remiqora_progress.total = total;
+    remiqora_write_progress_locked();
+}
+
+inline void remiqora_advance_progress(int64_t current, bool force = false) noexcept {
+    if (!force && current % 32 != 0) return;
+    std::lock_guard<std::mutex> guard(remiqora_progress.mutex);
+    remiqora_progress.current = current;
+    remiqora_write_progress_locked();
+}
+
+}  // namespace engine::models::yue2
